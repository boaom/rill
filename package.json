{
  "name": "rill",
  "private": true,
  "version": "0.1.0",
  "description": "溪流（Rill）——离线、纯本地假数据的极简信息流客户端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "gen:mock": "node scripts/gen-mock.mjs",
    "check:mock": "node scripts/check-mock.mjs",
    "build": "node scripts/check-mock.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4179 --strictPort",
    "check:ui": "node scripts/check-hit.mjs",
    "test:write": "node --test server/test/write-ops.mjs",
    "test:device": "node --test test/device-provider.test.mjs",
    "check:device": "node scripts/check-device-direct.mjs",
    "check:online": "node scripts/check-online-writes.mjs",
    "server": "node server/index.mjs",
    "dev:full": "node server/dev-full.mjs",
    "cap:sync": "pnpm build && npx cap sync android",
    "apk:debug": "node -e \"console.error('apk:debug 需要 JDK/Android SDK；本机未安装，请在 GitHub Actions 的 android.yml 中构建（不要本地安装 SDK）'); process.exit(1)\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
